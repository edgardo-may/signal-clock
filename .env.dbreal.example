# DBREAL must point only to an isolated local, test, or staging Supabase project.
# Never copy production credentials or a production host into this file.
SUPABASE_TEST_URL=https://your-isolated-test-project.supabase.co
SUPABASE_TEST_ANON_KEY=replace-with-test-anon-key
SUPABASE_TEST_SERVICE_ROLE_KEY=replace-with-test-service-role-key
PHASE2_AUDIT_DATABASE_URL=postgresql://postgres:replace-with-test-password@db.your-isolated-test-project.supabase.co:5432/postgres
PHASE2_AUDIT_DB_LABEL=test

# Required by DBREAL only after the target has been independently verified as non-production.
ALLOW_DESTRUCTIVE_TEST_DB=false

# Optional additional production-host denial guard. Set this only to the known production hostname.
PHASE2_PRODUCTION_HOST=production-project.supabase.co
