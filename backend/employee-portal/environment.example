# Server-only. NEVER prefix these secrets with VITE_.
VITE_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
EMPLOYEE_ORIGIN=http://localhost:3000
EMPLOYEE_RATE_PEPPER=
# Set true on the API deployment during a coordinated Employee release window.
EMPLOYEE_PORTAL_MAINTENANCE=false
# Public build-time gate for Employee routes only; contains no secret.
VITE_EMPLOYEE_PORTAL_MAINTENANCE=false
# Local HTTP only. Production always requires HTTPS and Secure cookie.
EMPLOYEE_ALLOW_INSECURE_LOOPBACK_COOKIE=true
